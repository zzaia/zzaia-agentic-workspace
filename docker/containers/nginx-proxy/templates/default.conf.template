# Auto-generated via envsubst from this template at container start
# (docker-entrypoint.d/20-envsubst-on-templates.sh). Only container-env
# variables are substituted — nginx's own $vars (no braces) are untouched.
resolver 127.0.0.11 valid=10s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name vault.${WORKSPACE_NAME}.local;
    set $upstream vault-server:8200;
    location / { include /etc/nginx/proxy.inc; proxy_pass http://$upstream; }
}

