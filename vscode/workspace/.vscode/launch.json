{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch AppHost (aspire run)",
      "type": "node-terminal",
      "request": "launch",
      "command": "aspire run",
      "cwd": "${workspaceFolder}/host/Zzaia.AppHost",
      "postDebugTask": "apphost:stop"
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
